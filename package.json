{
  "name": "embuild-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:single-preview": "node scripts/build-single-app-preview.mjs",
    "build:standalone": "node scripts/build-standalone-app.mjs",
    "build:fin-indicatoren:standalone": "node scripts/build-standalone-app.mjs fin-indicatoren",
    "build:merge": "node scripts/merge-outputs.mjs",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck",
    "deploy": "turbo run build && node scripts/merge-outputs.mjs",
    "docs": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check",
    "validate:embeds": "node scripts/validate_embed_consistency.js"
  },
  "devDependencies": {
    "turbo": "^2",
    "wrangler": "^4.79.0"
  },
  "packageManager": "pnpm@10.33.0"
}
